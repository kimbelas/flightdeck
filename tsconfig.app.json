{
  "//": "The Next app compiles against the DOM; core/ must not. Keeping them in separate projects is what stops `document` or `window` from type-checking inside core/, which no lint rule would catch.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    "proxy.ts",
    "contracts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
