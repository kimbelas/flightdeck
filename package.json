{
  "name": "flightdeck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Control tower for every Claude Code session across both subscriptions",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:win": "vitest run tests/win --passWithNoTests --coverage.enabled=false",
    "smoke": "node tests/e2e/smoke.mjs",
    "smoke:dev": "node tests/e2e/smoke.mjs --dev",
    "roadmap": "node scripts/roadmap-cli.ts",
    "status": "node scripts/flightdeck-core.ts status",
    "doctor": "node scripts/doctor-cli.ts",
    "task:install": "node scripts/install-task-cli.ts",
    "task:remove": "node scripts/install-task-cli.ts remove",
    "roadmap:check": "node scripts/roadmap-cli.ts --check",
    "transcript:probe": "node scripts/transcript-probe-cli.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run roadmap:check && npm test",
    "dev": "next dev -H 127.0.0.1 -p 4949",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4949",
    "connect": "node scripts/connect-cli.ts connect",
    "disconnect": "node scripts/connect-cli.ts disconnect",
    "otlp": "node scripts/otlp-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0",
    "ws": "8.21.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "next": "16.3.4",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "toasted-notifier": "10.1.0"
  }
}
