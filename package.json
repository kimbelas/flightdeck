{
  "name": "flightdeck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Control tower for every Claude Code session across both subscriptions",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:win": "vitest run tests/win --passWithNoTests --coverage.enabled=false",
    "roadmap": "node scripts/roadmap-cli.ts",
    "roadmap:check": "node scripts/roadmap-cli.ts --check",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run roadmap:check && npm test",
    "dev": "next dev -H 127.0.0.1 -p 4949",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4949"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "ws": "8.21.3",
    "yaml": "^2.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "next": "16.3.4",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
